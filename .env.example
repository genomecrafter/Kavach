# KAVACH configuration. Copy this file to `.env` (same folder) and fill in the key(s) you use.
# `.env` is git-ignored; never commit real keys. Values are plain text: no quotes, no spaces around `=`.

# Required for the default provider (Gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: other OpenAI-compatible providers (select with --provider groq | openai | ollama)
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional: client-side rate limit in requests/minute (useful on free tiers)
# KAVACH_RPM=10
